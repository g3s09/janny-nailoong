# Copy to .env.local. Never put service_role credentials in browser variables.
NEXT_PUBLIC_SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_URL is also supported for existing integrations.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Optional: leave blank until the actual rig file is available.
NEXT_PUBLIC_NAILOONG_RIVE=
NEXT_PUBLIC_RIVE_STATE_MACHINE=Nailoong
